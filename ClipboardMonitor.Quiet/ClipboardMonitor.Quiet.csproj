<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);1591;SYSLIB1054</NoWarn>
    <Title>ClipboardMonitor.Quiet</Title>
    <Authors>davpnuser;JPS</Authors>
    <Description>A fork of ClipboardMonitor.Core without the built-in "Debugging" console writes that for some reason werent removed in the release build.</Description>
    <PackageLicenseFile>Licence.txt</PackageLicenseFile>
    <PackageReadmeFile>README (External).md</PackageReadmeFile>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl>https://github.com/davpnuser/ClipboardMonitor.Quiet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	  
    <PackageTags>clipboard;windows;linux;monitor;monitoring;notifications;events;utility;tool;csharp;dotnet</PackageTags>
	  
    <AssemblyVersion>3.0.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Licence.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README (External).md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="runtimes\win-x64\native\ClipboardMonitor.Windows.dll" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="runtimes\linux-x64\native\libClipboardMonitor.Linux.so" Pack="true" PackagePath="runtimes/linux-x64/native" />
    <!--<None Include="runtimes\osx-x64\native\libClipboardMonitor.Mac.dylib" Pack="true" PackagePath="runtimes/osx-x64/native" />-->
  </ItemGroup>

</Project>
